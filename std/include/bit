#ifndef _LENSOR_OS_BIT_H
#define _LENSOR_OS_BIT_H

#include <bits/decls.h>
#include <stddef.h>
#include <stdint.h>

// NOTE: <bit> is used by a lot of things, and including things here can
// easily cause circular dependencies.

namespace std {

enum class endian {
    // Thanks GNU :)
    little = __ORDER_LITTLE_ENDIAN__,
    big = __ORDER_BIG_ENDIAN__,
    native = __BYTE_ORDER__
};

template <typename _To, typename _From>
    requires(sizeof(_To) == sizeof(_From))
constexpr _To bit_cast(const _From& __from) {
    return __builtin_bit_cast(_To, __from);
}

template <class _T>
constexpr _T byteswap(_T n) noexcept {
    // static_assert(std::has_unique_object_representations_v<_T>, "T may not have padding bits");

    // No swapping needed
    if constexpr (sizeof(_T) == 1)
        return n;

    // Use hardware instructions for standard integer sizes.
    else if constexpr (sizeof(_T) == 2) {
        return static_cast<_T>(
            __builtin_bswap16(static_cast<uint16_t>(n)));
    }
    else if constexpr (sizeof(_T) == 4) {
        return static_cast<_T>(
            __builtin_bswap32(static_cast<uint32_t>(n)));
    }
    else if constexpr (sizeof(_T) == 8) {
        return static_cast<_T>(
            __builtin_bswap64(static_cast<uint64_t>(n)));
    }

    // Use a manual loop for other sizes.
    else {
        // constexpr friendly reinterpret casting
        struct _Representation {
            uint8_t __data[sizeof(_T)];
        };
        _Representation __repr = std::bit_cast<_Representation>(n);

        size_t __left = 0;
        size_t __right = sizeof(_T) - 1;
        while (__left < __right) {
            uint8_t __tmp = __repr.__data[__left];
            __repr.__data[__left] = __repr.__data[__right];
            __repr.__data[__right] = __tmp;
            __left++;
            __right--;
        }

        return std::bit_cast<_T>(__repr);
    }
}

}  // namespace std

#endif /* _LENSOR_OS_BIT_H */
